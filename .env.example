# Copy to .env. Never commit .env.

# Google Cloud project with "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# ZoomInfo Enterprise API credentials. Enrichment is off unless ZOOMINFO_ENABLE=true.
ZOOMINFO_USERNAME=
ZOOMINFO_PASSWORD=
ZOOMINFO_ENABLE=false

# Which territory (where) and profile (what) to run. Override per run with
# --territory / --profile.
ZIPLEADS_TERRITORY=territories/twin-cities-comcast.toml
ZIPLEADS_PROFILE=profiles/telecom-new-business.toml

# SQLite store. One database per territory is the simplest setup.
ZIPLEADS_DB=data/leads.sqlite

# Daily email for `zipleads send`. Gmail: smtp.gmail.com, port 465, an App Password
# (not your account password). MAIL_TO is comma-separated.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Google Sheet feedback loop (optional). Create a service account in the same Cloud
# project as the Places key, download its JSON key to data/ (gitignored), and share
# the sheet with the service account's email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_JSON=data/service-account.json

# How far back ingest looks on each run.
INGEST_DAYS=7

# Copy to .env. Never commit .env.

# Google Cloud project with "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# ZoomInfo Enterprise API credentials. Enrichment is off unless ZOOMINFO_ENABLE=true.
ZOOMINFO_USERNAME=
ZOOMINFO_PASSWORD=
ZOOMINFO_ENABLE=false

# Which territory (where) and profile (what) to run. Override per run with
# --territory / --profile.
ZIPLEADS_TERRITORY=territories/twin-cities-comcast.toml
ZIPLEADS_PROFILE=profiles/telecom-new-business.toml

# SQLite store. One database per territory is the simplest setup.
ZIPLEADS_DB=data/leads.sqlite

# How far back ingest looks on each run.
INGEST_DAYS=7
